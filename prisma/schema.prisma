generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   // "admin" | "coach" | "customer"
  /// When role = "customer", optionally links this account to the athlete
  /// record managed by their coach. One Customer ↔ at most one User.
  customerId   String?  @unique
  customer     Customer? @relation("CustomerAccount", fields: [customerId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  camps          Camp[]   @relation("CoachCamps")
  createdCamps   Camp[]   @relation("CampCreator")
  createdClasses Class[]  @relation("ClassCreator")
  todos          Todo[]
  chatSessions   ChatSession[]
}

model ChatSession {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String   @default("New chat")
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages      ChatMessage[]

  @@index([userId, lastMessageAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

model Todo {
  id        String    @id @default(cuid())
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  done      Boolean   @default(false)
  source    String    @default("manual") // "manual" | "ai" | "slash"
  createdAt DateTime  @default(now())
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  email         String?
  phone         String?
  gender        String?  // "male" | "female"
  division      String?  // "open" | "pro" | "doubles" | "relay"
  age           Int?
  weightKg      Float?
  heightCm      Float?
  goalRaceDate  DateTime?
  hyroxPbSec    Int?
  notes         String?
  tags          String?
  /// Set once the athlete completes the first-login onboarding modal. Null =
  /// show onboarding. Coach-created profiles also start null until claimed.
  onboardedAt   DateTime?
  createdAt     DateTime @default(now())

  /// Reverse side of the optional account link (User.customerId).
  userAccount   User?         @relation("CustomerAccount")
  benchmarks    Benchmark[]
  rosterEntries RosterEntry[]
  logs          Log[]
  activities    ActivityData[]
  videos        Video[]
  campMembers   CampMember[]
  chatSessions  ChatSession[]
  performances  Performance[]
  raceResults   RaceResult[]
  raceGoals     RaceGoal[]
  classReports  ClassReport[]
  watchData     ClassWatchData[]
  mockResults   MockResult[]
  ownedWorkouts Workout[]     @relation("CustomerOwnedWorkouts")
  racePlans     RacePlan[]
  assignments   WorkoutAssignment[]
  adviceItems   CoachAdvice[]
}

/// A workout for one athlete to do OUTSIDE of a class — either pushed by a
/// coach or self-created by the athlete. Carries the athlete's completion log
/// (status / RPE / feeling / per-exercise results) and optional per-workout
/// coach guidance (a training suggestion + food advice).
model WorkoutAssignment {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workoutId     String
  workout       Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  /// Set when this row is part of a camp's weekly training plan (fanned out to
  /// each member). Null = an individual / self-assigned workout.
  campId        String?
  camp          Camp?    @relation(fields: [campId], references: [id], onDelete: SetNull)
  /// User who assigned it (coach/admin). Null = the athlete created it for themselves.
  assignedById  String?
  scheduledDate DateTime?
  status        String   @default("assigned") // assigned | completed | skipped
  completedAt   DateTime?
  rpe           Int?
  feeling       String?
  notes         String?
  resultsJson   String?  // per-exercise achieved: { "<itemId>": "value" }
  coachSuggestion String?
  foodAdvice    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Multiple workouts can be assigned to the same member on the same camp day,
  // so per-day uniqueness now includes the workout.
  @@unique([campId, customerId, scheduledDate, workoutId], map: "WorkoutAssignment_plan_unique")
  @@index([customerId, status])
  @@index([customerId, scheduledDate])
}

/// Standing coach-to-athlete guidance, not tied to a single workout — a running
/// feed of training suggestions and nutrition advice the athlete can read.
model CoachAdvice {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String?  // coach/admin who wrote it
  kind       String   @default("general") // general | training | nutrition
  body       String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

/// A race the athlete plans to attend, in a specific division. Sourced from
/// the curated UPCOMING_RACES schedule (raceId/raceName/raceDate are
/// denormalized from that list). One row per (customer, race, division), so an
/// athlete can plan several races and several divisions per race.
model RacePlan {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  raceId     String   // key from UPCOMING_RACES, e.g. "hangzhou"
  raceName   String   // denormalized label, e.g. "Hangzhou"
  raceDate   DateTime // race start date
  division   String   // "open" | "pro" | "doubles" | "relay"
  createdAt  DateTime @default(now())

  @@unique([customerId, raceId, division])
  @@index([customerId, raceDate])
}

// A completed Hyrox race (or simulation). Splits are flat — 8 runs + 8 stations
// — because the Hyrox format is fixed. PB-per-division is derived from this
// table; no separate PB column on Customer.
model RaceResult {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  eventName     String
  eventDate     DateTime
  division      String   // "open" | "pro" | "doubles" | "relay"
  totalSec      Int
  roxzoneSec    Int?     // additive transition time

  // 8 runs (1 km each), in race order
  run1Sec       Int?
  run2Sec       Int?
  run3Sec       Int?
  run4Sec       Int?
  run5Sec       Int?
  run6Sec       Int?
  run7Sec       Int?
  run8Sec       Int?

  // 8 stations, in race order
  skiSec         Int?
  sledPushSec    Int?
  sledPullSec    Int?
  burpeeSec      Int?
  rowSec         Int?
  farmersSec     Int?
  lungesSec      Int?
  wallballsSec   Int?

  notes         String?
  createdAt     DateTime @default(now())

  @@index([customerId, division, totalSec])
  @@index([customerId, eventDate])
}

// Improvement targets per athlete per division. Single row per (customer,
// division). Per-station targets unlock the radar's "vs goal" mode.
model RaceGoal {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  division      String   // "open" | "pro" | "doubles" | "relay"

  targetTotalSec   Int?
  targetDate       DateTime?

  targetSkiSec         Int?
  targetSledPushSec    Int?
  targetSledPullSec    Int?
  targetBurpeeSec      Int?
  targetRowSec         Int?
  targetFarmersSec     Int?
  targetLungesSec      Int?
  targetWallballsSec   Int?
  targetRunSec         Int?  // avg run pace target (per 1km)

  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([customerId, division])
}

model Benchmark {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  metric     String
  value      Float
  unit       String
  testedAt   DateTime @default(now())
}

model ActivityData {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  date         DateTime
  activityType String   // "run" | "row" | "ski" | "ride" | "hyrox_sim"
  durationSec  Int?
  distanceM    Int?
  avgHr        Int?
  maxHr        Int?
  avgPaceSec   Int?    // sec / km
  avgCadence   Int?
  caloriesKcal Int?
  notes        String?
  source       String  @default("manual") // "manual" | "garmin"
  createdAt    DateTime @default(now())
}

model Video {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title      String
  filePath   String   // relative path under /public/uploads
  exercise   String?  // e.g. "wall_ball", "sled_push"
  notes      String?
  uploadedAt DateTime @default(now())
}

model Camp {
  id          String   @id @default(cuid())
  name        String
  description String?
  division    String   @default("open")  // "open" | "pro" — camp type
  startDate   DateTime
  endDate     DateTime
  coachId     String?
  coach       User?    @relation("CoachCamps", fields: [coachId], references: [id])
  createdById String?
  createdBy   User?    @relation("CampCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  members  CampMember[]
  classes  Class[]
  assignments WorkoutAssignment[]
}

model CampMember {
  id         String   @id @default(cuid())
  campId     String
  camp       Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// "active" = a member; "pending" = the customer applied and awaits approval.
  /// Staff add → active; customer applies → pending; approve → active.
  status     String   @default("active")
  joinedAt   DateTime @default(now())

  @@unique([campId, customerId])
}

model Workout {
  id          String   @id @default(cuid())
  name        String
  description String?
  tags        String?  // comma-separated, e.g. "pro team,strength"
  /// When set, this is a private workout a customer built for themselves —
  /// visible only to them, not in the shared coach library. Null = shared.
  ownerCustomerId String?
  owner       Customer? @relation("CustomerOwnedWorkouts", fields: [ownerCustomerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  items       WorkoutItem[]
  classes     ClassWorkout[]
  performances Performance[]
  assignments WorkoutAssignment[]

  @@index([ownerCustomerId])
}

model WorkoutItem {
  id           String   @id @default(cuid())
  workoutId    String
  workout      Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  order        Int      @default(0)
  category     String   // ski | sled_push | sled_pull | burpee | row | farmers | lunges | wallball | run | rest | strength | other
  label        String?  // optional override; otherwise label comes from category
  distanceM    Int?
  timeSec      Int?
  weightKg     Float?
  reps         Int?
  sets         Int?
  paceSecPerKm Int?
  heightM      Float?
  notes        String?
  /// Optional training tag for grouping/coloring an exercise: warmup | strength
  /// | cardio | core | mobility | cooldown. Null = untagged.
  tag          String?

  @@index([workoutId, order])
}

model ClassWorkout {
  id        String  @id @default(cuid())
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  order     Int     @default(0)
  /// How many times this workout is performed in the class (e.g. 4 rounds).
  rounds    Int     @default(1)
  createdAt DateTime @default(now())

  @@unique([classId, workoutId])
  @@index([classId, order])
}

model Class {
  id          String   @id @default(cuid())
  title       String
  startsAt    DateTime
  durationMin Int      @default(60)
  location    String?
  capacity    Int      @default(12)
  notes       String?
  dropInAllowed Boolean @default(false)  // when true, athletes outside the camp can join
  /// Set when a coach asks the class's members to submit post-class feedback.
  feedbackRequestedAt DateTime?
  /// Set when a coach cancels the class. Drives the "canceled" status; the rest
  /// (open / full / finished) is derived from capacity + start time.
  canceledAt  DateTime?
  /// A "mock test" class: athletes record a time per exercise (or one total
  /// time) and can review the result on their dashboard/profile.
  isMockTest  Boolean  @default(false)
  campId      String?
  camp        Camp?    @relation(fields: [campId], references: [id])
  createdById String?
  createdBy   User?    @relation("ClassCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  roster       RosterEntry[]
  workouts     ClassWorkout[]
  performances Performance[]
  reports      ClassReport[]
  watchData    ClassWatchData[]
  mockResults  MockResult[]
}

/// One athlete's result for a mock-test class: a time per exercise (keyed by
/// WorkoutItem id) and/or a single total time as a fallback.
model MockResult {
  id         String   @id @default(cuid())
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  totalSec   Int?     // single total time, when per-exercise isn't recorded
  timesJson  String?  // JSON map { "<workoutItemId>": seconds }
  notes      String?
  recordedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([classId, customerId])
  @@index([customerId, recordedAt])
}

model RosterEntry {
  id         String   @id @default(cuid())
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  attendance String   @default("pending")
  createdAt  DateTime @default(now())

  logs       Log[]

  @@unique([classId, customerId])
}

model Performance {
  id           String   @id @default(cuid())
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workoutId    String?  // null = legacy class-overall; new rows always set this
  workout      Workout? @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  status       String   @default("pending") // pending | completed | partial | dnf
  rpe          Int?     // perceived exertion 1-10
  fatiguePct   Int?     // 0-100 (e.g. "80% tired")
  feeling      String?  // short free text, e.g. "legs heavy"
  injuryNote   String?  // injury flag / note — empty means no concern
  notes        String?
  resultsJson  String?  // per-exercise achieved: { "<itemId>": "achieved value" } — scoped to this workout
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([classId, customerId, workoutId])
  @@index([customerId, createdAt])
}

model Log {
  id            String      @id @default(cuid())
  rosterEntryId String
  rosterEntry   RosterEntry @relation(fields: [rosterEntryId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  exerciseName  String
  resultJson    String
  createdAt     DateTime    @default(now())
}

/// AI prompt content, editable from /admin/prompts. `key` is referenced by
/// code (e.g. "chat.system", "report.postClass"); content can be edited in
/// the app. If a key has no row yet, the reader falls back to the bundled
/// `src/prompts/<key>.md` file so the app keeps working on a fresh DB.
model Prompt {
  key         String   @id
  name        String
  description String?
  content     String
  updatedAt   DateTime @updatedAt
  updatedById String?
  createdAt   DateTime @default(now())
}

/// AI-generated post-class report for one athlete. One row per (class, customer).
/// Coach can edit `contentMarkdown` before publishing; athletes only see
/// reports where `publishedAt` is set.
model ClassReport {
  id              String   @id @default(cuid())
  classId         String
  class           Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contentMarkdown String
  model           String?
  generatedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?

  @@unique([classId, customerId])
  @@index([customerId, generatedAt])
}

/// Sport-watch / wearable metrics for one athlete in one class. One row per
/// (class, customer). Entered by the coach (or imported later) off a Garmin /
/// Apple Watch / Whoop summary. Feeds the post-class report so the AI can
/// reason about real cardiac load, not just self-reported RPE.
model ClassWatchData {
  id           String   @id @default(cuid())
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  durationSec  Int?     // active / moving time
  distanceM    Int?
  avgHr        Int?
  maxHr        Int?
  caloriesKcal Int?
  avgCadence   Int?     // spm
  // Time spent in each HR zone, in seconds — drives aerobic vs anaerobic read.
  zone1Sec     Int?
  zone2Sec     Int?
  zone3Sec     Int?
  zone4Sec     Int?
  zone5Sec     Int?

  // Garmin-style training metrics
  aerobicTE    Float?   // aerobic training effect (0.0–5.0)
  anaerobicTE  Float?   // anaerobic training effect (0.0–5.0)
  exerciseLoad Int?     // session training load

  // Nutrition & hydration
  restingCalories Int?
  activeCalories  Int?
  sweatLossMl     Int?  // estimated sweat loss

  source       String   @default("manual") // manual | garmin | apple | whoop | polar
  notes        String?
  recordedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([classId, customerId])
  @@index([customerId, recordedAt])
}
