# Database — Supabase session-mode pooler URL.
# Get it from: Supabase Dashboard → Project Settings → Database → Connection string → Session.
# Format: postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Special characters in the password must be URL-encoded (e.g. '@' → '%40').
DATABASE_URL=""

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# AI co-coach (Anthropic-compatible). Chat is disabled until these are set.
AI_API_KEY=""
AI_BASE_URL=""
# Optional — defaults to "deepseek-v4-pro" if omitted.
AI_MODEL=""

# Vision model for the food-photo macro estimator (the "Take a photo" button on
# the meal logger). Uses the Anthropic-compatible Messages API, so any provider
# that exposes one works — e.g. SiliconFlow: https://api.siliconflow.cn
# The MODEL must be VISION-CAPABLE (multimodal). Verified working on SiliconFlow:
#   moonshotai/Kimi-K2.7-Code      (Moonshot Kimi — multimodal, tested ✓)
#   Qwen/Qwen2.5-VL-72B-Instruct   (Qwen vision)
# A reasoning ("thinking") model can spend ~5k tokens before the JSON, so the
# request uses max_tokens 8000. The photo button only appears once API_KEY *and*
# MODEL are both set.
AI_VISION_API_KEY=""
AI_VISION_BASE_URL="https://api.siliconflow.cn"
AI_VISION_MODEL="moonshotai/Kimi-K2.7-Code"
